# Copy to .env to override defaults. No secrets are required to run the prototype.
# All variables use the DHT_ prefix (see backend/app/config.py).

# Database (SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/db)
DHT_DATABASE_URL=sqlite:///./data/twin.db

# Seed one synthetic subject with history on first start
DHT_SEED_ON_STARTUP=true
DHT_HISTORY_DAYS=7
DHT_HISTORY_INTERVAL_S=300
DHT_HISTORY_SEED=7
DHT_DEMO_SEED=42

# Live demo pacing: one reading per tick; each tick advances twin time
DHT_TICK_SECONDS=1.0
DHT_TWIN_SECONDS_PER_TICK=15
DHT_AUTOSTART_LIVE=true

# Allowed browser origins for the dev server
DHT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DHT_LOG_LEVEL=INFO
